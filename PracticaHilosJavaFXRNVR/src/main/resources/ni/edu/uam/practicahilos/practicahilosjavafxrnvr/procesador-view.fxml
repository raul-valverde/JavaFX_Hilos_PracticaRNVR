<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.practicahilos.practicahilosjavafxrnvr.ProcesadorController"
      alignment="CENTER_LEFT"
      spacing="15"
      prefWidth="560"
      prefHeight="460">

    <padding>
        <Insets top="20" right="25" bottom="20" left="25"/>
    </padding>

    <!-- Título de la aplicación -->
    <Label text="Monitor de procesos"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <!-- ======================================================= -->
    <!-- NUEVO: Sección independiente para Clientes (100 ítems)  -->
    <!-- ======================================================= -->
    <VBox spacing="5" style="-fx-border-color: #dcdcdc; -fx-border-radius: 5; -fx-padding: 10;">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Clientes:" style="-fx-font-weight: bold;"/>
            <Label fx:id="lblEstadoClientes" text="En espera"/>
        </HBox>

        <HBox alignment="CENTER" spacing="10">
            <!-- Barra de progreso para el hilo de clientes -->
            <ProgressBar fx:id="barraClientes" progress="0" prefWidth="380"/>
            <Label fx:id="lblPorcentajeClientes" text="0%"/>
        </HBox>

        <HBox alignment="CENTER_RIGHT" spacing="10">
            <!-- Botones individuales para controlar el hilo de Clientes -->
            <Button fx:id="btnIniciarClientes" text="Iniciar Clientes" onAction="#iniciarClientes"/>
            <Button fx:id="btnDetenerClientes" text="Detener Clientes" onAction="#detenerClientes" disable="true"/>
        </HBox>
    </VBox>

    <!-- ======================================================= -->
    <!-- NUEVO: Sección independiente para Productos (50 ítems)  -->
    <!-- ======================================================= -->
    <VBox spacing="5" style="-fx-border-color: #dcdcdc; -fx-border-radius: 5; -fx-padding: 10;">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Productos:" style="-fx-font-weight: bold;"/>
            <Label fx:id="lblEstadoProductos" text="En espera"/>
        </HBox>

        <HBox alignment="CENTER" spacing="10">
            <!-- Barra de progreso para el hilo de productos -->
            <ProgressBar fx:id="barraProductos" progress="0" prefWidth="380"/>
            <Label fx:id="lblPorcentajeProductos" text="0%"/>
        </HBox>

        <HBox alignment="CENTER_RIGHT" spacing="10">
            <!-- Botones individuales para controlar el hilo de Productos -->
            <Button fx:id="btnIniciarProductos" text="Iniciar Productos" onAction="#iniciarProductos"/>
            <Button fx:id="btnDetenerProductos" text="Detener Productos" onAction="#detenerProductos" disable="true"/>
        </HBox>
    </VBox>

    <!-- ======================================================= -->
    <!-- NUEVO: Botones para simulación global y reinicio         -->
    <!-- ======================================================= -->
    <HBox alignment="CENTER" spacing="15">
        <Button fx:id="btnSimularTodo" text="Simular" onAction="#simularTodo"/>
        <Button fx:id="btnReiniciar" text="Reiniciar" onAction="#reiniciarTodo"/>
    </HBox>

</VBox>